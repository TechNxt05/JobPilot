GROQ_API_KEY=your_groq_api_key
OPENAI_API_KEY=your_openai_api_key
SERPER_API_KEY=your_serper_api_key
# Fallback AI providers: used automatically when the primary fails (bad key, rate limit, outage)
GEMINI_API_KEY=
OPENROUTER_API_KEY=
LLM_FALLBACK_ORDER=groq,gemini,openrouter,openai
# Optional model overrides
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_MODEL=gpt-4o
# Supabase project shared with the web app and extension (Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Comma-separated frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:3000
