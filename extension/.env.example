# Template only: copy to .env and fill in there. Never put real keys in this file (it's committed to git).
# Optional build settings. Leave empty for a local-only build.
# Supabase dashboard -> Project Settings -> API. The anon/publishable key is safe to ship (RLS protects data).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Deployed JobPilot website, for hosted AI (signed-in users get AI without their own keys)
JOBPILOT_API_URL=https://your-jobpilot-site.vercel.app
