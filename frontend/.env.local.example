# Template only: copy to .env.local and fill in there. Never put real keys in this file (it's committed to git).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
NEXT_PUBLIC_API_URL=http://localhost:8000
# Server-only AI keys (never sent to the browser). Any subset; tried in LLM_FALLBACK_ORDER.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
LLM_FALLBACK_ORDER=groq,gemini,openrouter,openai
# Optional model overrides
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-3.5-flash-lite
OPENROUTER_MODEL=openrouter/free
# Optional: company research for cover letters (DuckDuckGo is used without it)
SERPER_API_KEY=
